{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quotespec.dev/schema/quotespec-v0.1.json",
  "title": "QuoteSpec Protocol v0.1",
  "description": "开放报价协议：让任何企业的 AI 读出结构化报价。字段只增不删；破坏性变更升 minor。",
  "oneOf": [
    { "$ref": "#/$defs/RFQ" },
    { "$ref": "#/$defs/Quote" }
  ],
  "$defs": {
    "Money": {
      "type": "object",
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "examples": ["CNY", "USD", "EUR"] }
      }
    },
    "PartyRef": {
      "type": "object",
      "required": ["party_id", "verified"],
      "properties": {
        "party_id": { "type": "string", "minLength": 1 },
        "legal_name": { "type": "string" },
        "verified": { "type": "boolean" },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "能力标签，如 cnc_milling / anodizing / injection_molding"
        },
        "regions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "FileRef": {
      "type": "object",
      "required": ["kind", "release"],
      "properties": {
        "kind": { "type": "string", "examples": ["step", "dwg", "pdf", "xlsx"] },
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string" },
        "release": {
          "type": "string",
          "enum": ["L0_redacted_features", "L1_full_auth", "L2_production"],
          "description": "L0 脱敏特征（广播即给）；L1 完整文件（NDA 后）；L2 生产文件（托管付款后）"
        }
      }
    },
    "QuantityTier": {
      "type": "object",
      "required": ["qty", "unit"],
      "properties": {
        "qty": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string", "examples": ["piece", "set", "carton", "kg", "cbm"] },
        "note": { "type": "string" }
      }
    },
    "PriceTier": {
      "type": "object",
      "required": ["qty", "unit", "unit_price", "currency", "moq_ok"],
      "properties": {
        "qty": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "type": "string" },
        "unit_price": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "moq_ok": { "type": "boolean" },
        "moq": { "type": "number", "exclusiveMinimum": 0 },
        "note": { "type": "string" }
      }
    },
    "LineItem": {
      "type": "object",
      "required": ["line_id", "category", "quantity_tiers", "spec"],
      "properties": {
        "line_id": { "type": "string", "minLength": 1, "examples": ["L1", "L2"] },
        "category": {
          "type": "string",
          "examples": ["cnc_part", "sheet_metal", "packaging", "logistics", "design_fee"]
        },
        "quantity_tiers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/QuantityTier" } },
        "spec": {
          "type": "object",
          "description": "按 category 的 spec 约定填写；见协议文档 3.3 节",
          "additionalProperties": true
        },
        "required_by": { "type": "string", "format": "date" },
        "acceptance": {
          "type": "object",
          "properties": {
            "inspection": { "type": "string", "examples": ["AQL 1.0", "全检"] },
            "sample": { "type": "string", "examples": ["first_article", "random"] }
          }
        },
        "file_refs": { "type": "array", "items": { "$ref": "#/$defs/FileRef" } }
      }
    },
    "RFQ": {
      "type": "object",
      "required": ["protocol", "type", "id", "buyer", "title", "deadline", "currency", "lines"],
      "properties": {
        "protocol": { "const": "quotespec/0.1" },
        "type": { "const": "rfq" },
        "id": { "type": "string" },
        "buyer": { "$ref": "#/$defs/PartyRef" },
        "title": { "type": "string" },
        "deadline": { "type": "string", "format": "date-time" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "lines": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/LineItem" } },
        "constraints": {
          "type": "object",
          "properties": {
            "incoterms": { "type": "string", "examples": ["FOB Shenzhen", "DDP Los Angeles"] },
            "tax": { "type": "string", "examples": ["VAT 13% included"] },
            "payment_terms": { "type": "string", "examples": ["30% deposit, 70% before shipment"] },
            "max_broadcast": { "type": "integer", "minimum": 1, "default": 20 }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "Quote": {
      "type": "object",
      "required": [
        "protocol", "type", "id", "rfq_id", "line_id", "supplier",
        "pricing", "lead_time_days", "valid_until", "assumptions",
        "exclusions", "responsibility", "ai"
      ],
      "properties": {
        "protocol": { "const": "quotespec/0.1" },
        "type": { "const": "quote" },
        "id": { "type": "string" },
        "rfq_id": { "type": "string" },
        "line_id": { "type": "string" },
        "supplier": { "$ref": "#/$defs/PartyRef" },
        "pricing": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/PriceTier" } },
        "lead_time_days": { "type": "integer", "minimum": 0 },
        "valid_until": { "type": "string", "format": "date-time" },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "报价成立的前提；为空视为不合格报价"
        },
        "exclusions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "不含项：模具费、运费、税费等必须显式列出"
        },
        "responsibility": {
          "type": "object",
          "required": ["warranty_days"],
          "properties": {
            "warranty_days": { "type": "integer", "minimum": 0 },
            "penalty": { "type": "string", "examples": ["延期 0.3%/天，上限 10%"] },
            "rerun_policy": { "type": "string", "examples": ["非买方原因返工由供应商承担"] }
          }
        },
        "ai": {
          "type": "object",
          "required": ["generated", "human_confirmed"],
          "properties": {
            "generated": { "type": "boolean" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "human_confirmed": { "type": "boolean" },
            "model": { "type": "string", "examples": ["openai/gpt-4o-mini", "openai/gpt-4o-mini"] }
          }
        },
        "attachments": { "type": "array", "items": { "$ref": "#/$defs/FileRef" } },
        "notes": { "type": "string" }
      }
    },
    "Credit": {
      "type": "object",
      "properties": {
        "rfq_responded_30d": { "type": "integer", "minimum": 0 },
        "median_response_minutes": { "type": "number", "minimum": 0 },
        "quotes_submitted_90d": { "type": "integer", "minimum": 0 },
        "award_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "price_vs_final_delta": { "type": "number" },
        "on_time_delivery": { "type": "number", "minimum": 0, "maximum": 1 },
        "first_pass_inspection": { "type": "number", "minimum": 0, "maximum": 1 },
        "dispute_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "sample_size_ok": { "type": "boolean" }
      }
    }
  }
}
